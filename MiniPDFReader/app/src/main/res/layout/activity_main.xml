<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#1a1a2e">

    <!-- Top toolbar: Search + Go To Page -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:background="#16213e"
        android:padding="8dp">

        <EditText
            android:id="@+id/searchInput"
            android:layout_width="0dp"
            android:layout_weight="2"
            android:layout_height="40dp"
            android:hint="Search text..."
            android:hintTextColor="#888"
            android:textColor="#ffffff"
            android:background="@drawable/input_bg"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:inputType="text"
            android:imeOptions="actionSearch"
            android:singleLine="true"
            android:textSize="13sp"/>

        <Button
            android:id="@+id/searchBtn"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:text="Search"
            android:textSize="12sp"
            android:backgroundTint="#0f3460"
            android:textColor="#e94560"
            android:layout_marginStart="6dp"/>

        <EditText
            android:id="@+id/pageInput"
            android:layout_width="0dp"
            android:layout_weight="0.8"
            android:layout_height="40dp"
            android:hint="Page"
            android:hintTextColor="#888"
            android:textColor="#ffffff"
            android:background="@drawable/input_bg"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:inputType="number"
            android:imeOptions="actionGo"
            android:singleLine="true"
            android:textSize="13sp"
            android:layout_marginStart="6dp"/>

        <Button
            android:id="@+id/goToBtn"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:text="Go"
            android:textSize="12sp"
            android:backgroundTint="#0f3460"
            android:textColor="#e94560"
            android:layout_marginStart="4dp"/>

    </LinearLayout>

    <!-- Search result info bar (hidden by default) -->
    <TextView
        android:id="@+id/searchInfo"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#0f3460"
        android:textColor="#e94560"
        android:textSize="12sp"
        android:padding="6dp"
        android:gravity="center"
        android:visibility="gone"/>

    <!-- PDF View -->
    <com.github.barteksc.pdfviewer.PDFView
        android:id="@+id/pdfView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"/>

    <!-- Bottom nav: Prev | Page info | Next -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:orientation="horizontal"
        android:background="#16213e"
        android:gravity="center_vertical">

        <Button
            android:id="@+id/prevBtn"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="match_parent"
            android:text="◀ Prev"
            android:textSize="13sp"
            android:backgroundTint="#0f3460"
            android:textColor="#ffffff"/>

        <TextView
            android:id="@+id/pageInfo"
            android:layout_width="0dp"
            android:layout_weight="1.2"
            android:layout_height="wrap_content"
            android:text="0 / 0"
            android:textColor="#e94560"
            android:textSize="14sp"
            android:textStyle="bold"
            android:gravity="center"/>

        <Button
            android:id="@+id/nextBtn"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="match_parent"
            android:text="Next ▶"
            android:textSize="13sp"
            android:backgroundTint="#0f3460"
            android:textColor="#ffffff"/>

    </LinearLayout>

</LinearLayout>
